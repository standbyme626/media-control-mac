# 复制成 .env 后按需修改

# ---------- 服务器侧 music-web ----------
MW_PORT=8098
# 想加密码就设 MW_AUTH=1 并填账号密码
MW_AUTH=0
MW_USER=media
MW_PASSWORD=
# ssh 到 Mac 用的别名（在 ~/.ssh/config 里配一个免密 Host）
MW_MAC=mac
MW_BRIDGE=http://127.0.0.1:8765

# ---------- Mac 侧 music-bridge ----------
MB_PORT=8765
MB_CDP_PORT=9222
# 蓝牙音响地址，冒号或短横线都行；留空则不启用蓝牙相关功能
MB_BT_ADDR=
MB_BT_NAME=
